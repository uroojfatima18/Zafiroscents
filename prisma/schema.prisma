generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  men
  women
  unisex
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  notesTop    String[]
  notesHeart  String[]
  notesBase   String[]
  category    Category
  images      String[]
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  variants    ProductVariant[]
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sizeMl          Int
  price           Int      // in PKR (smallest unit = 1 PKR)
  compareAtPrice  Int?
  stock           Int      @default(0)

  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@unique([productId, sizeMl])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?     // reserved for future auth — not used yet
  total           Int         // in PKR
  status          OrderStatus @default(pending)
  paymentMethod   String      @default("cod")
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  createdAt       DateTime    @default(now())

  items           OrderItem[]
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  priceAtPurchase  Int

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
